{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  /*
   * EVERY source directory is in here, deliberately.
   *
   * `server/` used to be excluded while online play was parked, and the result was
   * that the pivot deleted three modules the server still imported and nothing
   * noticed: `npm run typecheck` passed for months while `npm run dev` could not
   * boot the server at all. Code that is not typechecked is not code, it is a
   * rumour. If something here is genuinely dormant, delete it — git remembers.
   */
  "include": ["shared/**/*.ts", "client/**/*.ts", "server/**/*.ts", "vite.config.ts"]
}

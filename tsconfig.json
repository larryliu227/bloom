{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  /*
   * The simple version is local-only: pick a role, play a garden against bots on
   * this device. `server/` is the verified VOIDLINE engine (rooms, lobby, room
   * codes, reconnect tokens, rate limiting) kept for when online play returns —
   * it is parked out of the build until then rather than deleted.
   */
  "include": ["shared/**/*.ts", "client/**/*.ts", "vite.config.ts"]
}
